{
  "name": "pi-code",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pi-code/server --filter @pi-code/web dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @pi-code/e2e test",
    "e2e:perf": "pnpm --filter @pi-code/e2e perf",
    "e2e:compare": "node e2e/perf/compare.ts",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
